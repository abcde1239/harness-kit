{
  "name": "harness-kit",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Agent project onboarding, collaborative development and evidence-based verification",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.4",
  "bin": {
